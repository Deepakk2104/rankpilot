# Postgres connection string (Railway, Supabase, Neon, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/rankpilot"

# Random long string for signing JWTs
JWT_SECRET="change-this-to-a-long-random-string"

# Port for the API server
PORT=5000

# Optional: OpenAI-compatible key for AI-generated report summaries.
# If not set, the API falls back to a rule-based summary (no AI call).
OPENAI_API_KEY=""

# Optional: SerpApi key for real keyword rank checking.
# If not set, rank checks return a simulated position so the feature
# still works end-to-end in a demo.
SERPAPI_KEY=""

# Comma separated list of allowed frontend origins for CORS
CLIENT_ORIGIN="http://localhost:5173"
